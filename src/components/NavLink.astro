---
const {href, disabled, title} = Astro.props;
const active = href ? href == Astro.routePattern : false;
---
{
    disabled && (
        <a class:list={["navbar-item", "navbar-item-disabled"]} title={title ?? ""}><span><slot/></span><span class="navbar-item-end"></span></a>
    )
}

{
    !disabled && (
        href ? 
        (<a class:list={["navbar-item", active && "is-selected"]} href={href}><slot/><span class="navbar-item-end"></span></a>) : 
        (<p class:list={["navbar-item", active && "is-selected"]}><slot/><span class="navbar-item-end"></span></p>)
    )
}
<style>
    .navbar-item {
        position: relative;
		display: flex;
        width: 100%;
        user-select: none;
        color: var(--primary);
        line-height: 1.5;
    
        i {
            margin-right: 8px;
        }
    }

    .navbar-item-disabled {
        cursor: not-allowed;
        color: var(--text);
        span {
            text-decoration: line-through;
        }
    }

    .navbar-item > svg {
        max-height: 1.75rem;
    }

    .navbar-item:hover {
        background-color: inherit;
    }

	.navbar-item.is-selected {
		background-color: inherit;
	}

    .navbar-item .navbar-item-end {
        width: 0;
        margin-top: 4px;
        border-bottom: 2px solid var(--primary);
        transition: width 0.5s;
        position: absolute;
        bottom: 0;
        left: 0;
    }

    .navbar-item.is-selected .navbar-item-end, .navbar-item:not(.navbar-item-disabled):hover .navbar-item-end {
        width: 100%;
        padding: inherit;
    }
</style>